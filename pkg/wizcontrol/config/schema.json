{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cjbearman/wizcontrol/config.schema.json",
  "title": "wizcontrol config.yaml",
  "description": "Schema for the YAML configuration used by wizcontrol.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timezone": {
      "type": "string",
      "description": "IANA timezone name such as America/Chicago."
    },
    "evaluation_period": {
      "$ref": "#/$defs/duration"
    },
    "recheck_period": {
      "$ref": "#/$defs/duration"
    },
    "state_recovery_file": {
      "type": "string",
      "description": "Optional file path used to persist state across restarts."
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "mqtt": {
      "$ref": "#/$defs/mqtt"
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "colors": {
      "type": "object",
      "description": "Named colors keyed by friendly name.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lights": {
      "type": "object",
      "description": "Named lights keyed by friendly name. Values are IP or MAC addresses.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "light_groups": {
      "type": "object",
      "description": "Named groups of lights or light names.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "object",
      "description": "Named scenes. Each scene has an optional group and a list of scene elements.",
      "additionalProperties": {
        "$ref": "#/$defs/scene"
      }
    },
    "scene_groups": {
      "type": "object",
      "description": "Optional named groups of scenes.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calendarEntry"
      }
    }
  },
  "required": [
    "timezone",
    "colors",
    "lights",
    "light_groups",
    "scenes",
    "calendar"
  ],
  "$defs": {
    "duration": {
      "description": "Go time.Duration value represented as a YAML duration string or numeric value.",
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "number" }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "broadcast_address": {
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/duration"
        },
        "period": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "mqtt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "allow_control": {
          "type": "boolean"
        }
      },
      "required": ["url", "username", "password", "topic"]
    },
    "httpAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": ["username", "password"]
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 12120
        },
        "cert_chain": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/httpAuth"
        }
      }
    },
    "sceneItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "color": {
          "type": "string"
        }
      },
      "required": ["targets", "color"]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneItem"
          },
          "minItems": 1
        }
      },
      "required": ["elements"]
    },
    "calendarEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "mode": {
          "type": "string",
          "enum": ["all", "random", "rotate"]
        },
        "frequency": {
          "$ref": "#/$defs/duration"
        }
      },
      "required": ["name", "from", "to", "scenes"]
    }
  }
}
